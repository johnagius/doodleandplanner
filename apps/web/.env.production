# Public Google OAuth Client ID for the deployed web app.
#
# OAuth client IDs are NOT secret — they ship in the frontend bundle by design —
# so this is safe to commit. It enables "Sign in with Google".
#
# The client *secret* is intentionally absent: this app authenticates entirely
# in the browser via Google Identity Services (token flow), which uses only the
# Client ID. Never put the client secret in this (frontend) package.
VITE_GOOGLE_CLIENT_ID=310338340844-pucj0apummf3d1hqmuh2b3ckkpfs6k2p.apps.googleusercontent.com

# Real-time backend: the deployed Cloudflare Worker (Durable Object per room).
# This URL is public (not a secret) — it's the API origin, safe to commit. When
# set, the app uses HttpRepository (live, multi-device) instead of localStorage.
VITE_API_BASE=https://doodleandplanner-api.labrint.workers.dev
